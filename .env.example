# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres connection string (Neon console → Connect → "Pooled connection").
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Optional: GitHub sign-in (https://github.com/settings/developers).
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional: ORCID sign-in (https://orcid.org/developer-tools, a free public API client).
# Redirect URI: http://localhost:3000/api/auth/callback/orcid
# ORCID_SANDBOX="true" uses sandbox.orcid.org for testing.
ORCID_CLIENT_ID=""
ORCID_CLIENT_SECRET=""
ORCID_SANDBOX=""

# Email (verification links and password resets), sent with nodemailer over SMTP.
# Without SMTP_HOST, development prints the emails to the terminal running `pnpm dev`.
# Gmail example (free; needs 2-step verification and an app password,
# https://myaccount.google.com/apppasswords): host smtp.gmail.com, port 465,
# user = your Gmail address, password = the 16-character app password.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
# Must be an address the SMTP account may send as (for Gmail: the account itself).
EMAIL_FROM="OpenContext <you@gmail.com>"

# Sign-ups are limited to institutional addresses (lib/auth/institutional.ts).
# Extra domains to accept (comma-separated), e.g. a research lab that isn't a university:
EXTRA_EMAIL_DOMAINS=""
# Individual addresses to accept regardless of domain (comma-separated):
ALLOWED_EMAILS=""
